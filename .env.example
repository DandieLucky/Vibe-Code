# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Platform Pembelajaran Development Terintegrasi
# Salin file ini menjadi .env.local untuk pengembangan lokal
# ==============================================================================

# 1. Supabase Client Configuration (Dapat diakses di browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# 2. Supabase Server Configuration (HANYA diakses di server / Server Actions)
# PERINGATAN KEAMANAN: JANGAN PERNAH menyebarkan atau memasukkan Service Role Key ke frontend!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Mode Platform (demo / production)
# Jika Supabase belum dikonfigurasi, sistem otomatis menggunakan Demo Local Storage mode
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Optional: Google Sheets Integration API
# Masukkan credentials Service Account Google Cloud jika ingin sinkronisasi otomatis
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id

# 5. Kode Undangan Pendaftaran (opsional)
# Hanya dipakai jika registration_mode = 'invite_only' di tabel site_settings.
# Pisahkan dengan koma untuk banyak kode. JANGAN taruh di kode frontend.
INVITATION_CODES=KODE-FASILITATOR-2026
